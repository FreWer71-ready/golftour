# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: Service role key, used exclusively in Server Actions to write data.
# NEVER prefix this with NEXT_PUBLIC_ and never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin mode
# The PIN players enter to unlock admin mode (digits only, 4-8 characters).
ADMIN_PIN=1234
# Random 32+ character secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
