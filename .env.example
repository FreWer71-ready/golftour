# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# "anon" / "public" key on the legacy API keys tab, or "Publishable key"
# (starts with sb_publishable_...) on the new API keys tab — same thing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# "service_role" key on the legacy tab, or "Secret key" (starts with
# sb_secret_...) on the new tab — same thing. Server-only: used exclusively
# in Server Actions to write data. NEVER prefix this with NEXT_PUBLIC_ and
# never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Admin mode
# The PIN players enter to unlock admin mode (digits only, 4-8 characters).
ADMIN_PIN=1234
# Random 32+ character secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
